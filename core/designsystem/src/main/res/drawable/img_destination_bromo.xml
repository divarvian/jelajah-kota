<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">
  <!-- Dawn Sky -->
  <path android:pathData="M0,0 L200,0 L200,200 L0,200 Z">
    <aapt:attr name="android:fillColor">
      <gradient android:startX="100" android:startY="0" android:endX="100" android:endY="200" android:type="linear">
        <item android:offset="0.0" android:color="#FF2F54EB"/>
        <item android:offset="0.5" android:color="#FF722ED1"/>
        <item android:offset="0.8" android:color="#FFF759AB"/>
        <item android:offset="1.0" android:color="#FFFFC069"/>
      </gradient>
    </aapt:attr>
  </path>
  <!-- Mount Batok & Bromo Crater Silhouette -->
  <path android:pathData="M0,130 L40,90 L90,140 L160,80 L200,120 L200,200 L0,200 Z" android:fillColor="#FF141414"/>
  <path android:pathData="M40,150 L90,110 L150,160 L200,130 L200,200 L0,200 Z" android:fillColor="#FF262626"/>
  <!-- Sea of Sand Fog -->
  <path android:pathData="M0,170 C50,160 150,180 200,165 L200,200 L0,200 Z" android:fillColor="#80FFFFFF"/>
</vector>
