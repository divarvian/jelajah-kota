<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup Rules (API < 31).
  Excludes authentication tokens, session caches, and user preferences DataStore
  from unencrypted cloud backups.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore/" />
    <exclude domain="database" path="." />
</full-backup-content>
