# JelajahKota Environment Template
# Copy this file to `.env` (gitignored) and fill in your Supabase project URL and publishable key.
# For local Supabase CLI on Android Emulator, use http://10.0.2.2:54321
# NEVER put service_role or secret keys in this file or in Android clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
